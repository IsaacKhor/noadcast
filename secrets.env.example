# Copy to secrets.env and `chmod 600 secrets.env`. `noadcast serve` reads it
# from the working directory; process environment variables take precedence.

# Bearer token for the iOS app, at least 32 characters:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
NOADCAST_API_TOKEN=

# Bind loopback plus this machine's tailnet address; never 0.0.0.0.
NOADCAST_HOST=127.0.0.1,100.80.188.91
NOADCAST_PORT=8765

# Classification: gemini | claude | gemini-audio (audio control arm) | fake
NOADCAST_CLASSIFIER=gemini
NOADCAST_GEMINI_MODEL=gemini-3.5-flash
NOADCAST_CLAUDE_MODEL=claude-sonnet-5
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Transcription model directory (fetch with `noadcast models fetch`).
# NOADCAST_ASR_MODEL_DIR=data/models/tiny.en

# Transcription runs on the GPU by default (CUDA 12 / cuDNN 9 come from the
# nvidia-* pip wheels; only the NVIDIA driver is needed on the host):
# NOADCAST_ASR_DEVICE=cuda          # cuda | cpu
# NOADCAST_ASR_COMPUTE_TYPE=        # default float16 on cuda, int8 on cpu
# NOADCAST_POOL_WORKERS=4
# NOADCAST_POOL_THREADS=4
# NOADCAST_ASR_BATCH_SIZE=32
# CPU-only host: NOADCAST_ASR_DEVICE=cpu NOADCAST_POOL_WORKERS=6
#                NOADCAST_POOL_THREADS=2 NOADCAST_ASR_BATCH_SIZE=8
